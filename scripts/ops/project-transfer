def load_toml(path):
    with open(path, "rb") as f:
        return tomllib_loads(f.read().decode())


def data_dir_for(config_path, cfg):
    # SPEC §3.1：`[server] data_dir` > 設定檔所在目錄（字面所在，不跟 config.toml 本身的 symlink）。
    base = os.path.dirname(os.path.abspath(config_path))
    d = (cfg.get("server") or {}).get("data_dir")
    if d:
        d = os.path.expanduser(d)
        return d if os.path.isabs(d) else os.path.join(base, d)
    return base


def tq(s):
    # TOML basic string 的跳脫是 JSON 的子集以外再加 \uXXXX；json.dumps 產生的都合法。
    return json.dumps(s, ensure_ascii=False)


def toml_block(project, bots, host):
    out = ["", f"# project-transfer {now_iso()}：從 {project['host']} 移交過來（issue #710）", "[[projects]]",
           f"id = {tq(project['id'])}", f"path = {tq(project['path'])}", f"label = {tq(project['label'])}",
           f"host = {tq(host)}"]
    for b in bots:
        out += ["", "[[projects.bots]]", f"id = {tq(b['id'])}", f"name = {tq(b['name'])}", f"kind = {tq(b['kind'])}"]
        for key in ("model", "effort", "persona", "instruction_files", "identity", "herdr_session"):
            if b.get(key) not in (None, ""):
                out.append(f"{key} = {tq(b[key])}")
        if b.get("fast"):
            out.append("fast = true")
        arr = json.loads(b.get("args_json") or "[]")
        out.append("args = [" + ", ".join(tq(a) for a in arr) + "]")
        out.append("autostart = false")
        out.append(f"inject_hooks = {'true' if b.get('inject_hooks', 1) else 'false'}")
        out.append(f"auto_approve = {'true' if b.get('auto_approve', 1) else 'false'}")
        env = json.loads(b.get("env_json") or "{}")
        if env:
            out += ["", "[projects.bots.env]"] + [f"{tq(k)} = {tq(v)}" for k, v in sorted(env.items())]
    return "\n".join(out) + "\n"


def tomllib_loads(text):
    try:
        import tomllib
    except ImportError:
        die("需要 python 3.11 以上（tomllib）")
    return tomllib.loads(text)


# daemon 在專案清單為空時序列化成頂層的 `projects = []`（在第一個表頭之前）。接著再 append `[[projects]]`
# 就是 TOML 的 duplicate key，daemon 整顆起不來（智選hub 實測，2026-09-28）。
EMPTY_PROJECTS = re.compile(r"^\s*projects\s*=\s*\[\s*\]\s*(#.*)?$")


def compose_config(text, block):
    """回傳 (新的 config 文字, 它該解析成的樣子)。組出來的不等於「原本的 config 多一個專案」就丟 RuntimeError。"""
    old = tomllib_loads(text)
    lines = text.split("\n")
    if not old.get("projects"):
        for i, line in enumerate(lines):
            if line.lstrip().startswith("["):
                break
            if EMPTY_PROJECTS.match(line):
                del lines[i]
                break
    new_text = "\n".join(lines).rstrip("\n") + "\n" + block
    want = {**old, "projects": list(old.get("projects") or []) + tomllib_loads(block)["projects"]}
    try:
        got = tomllib_loads(new_text)
    except Exception as e:
        raise RuntimeError(f"追加專案後的 config.toml 解析不了（{e}）；目標 config 的 projects 寫法不是 [[projects]]，請手動處理")
    if got != want:
        raise RuntimeError("追加專案後的 config.toml 解析結果跟「原本多一個專案」不符；請手動處理")
    return new_text, want


def atomic_write(path, text):
    real = os.path.realpath(path)
    mode = os.stat(real).st_mode & 0o777 if os.path.exists(real) else 0o600
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".config.toml.transfer-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, real)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def take_lock(data_dir):
    path = os.path.join(data_dir, "daemon.lock")
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        who = open(path).read().strip() or "pid 不明"
        os.close(fd)
        die(f"目標資料目錄 {data_dir} 的 daemon 還在跑（daemon.lock：{who}）。先停目標 daemon 再 import，什麼都沒動。")
    return fd


def load_bundle(path):
    with gzip.open(path, "rb") as f:
        b = json.loads(f.read().decode())
    if b.get("format") != FORMAT:
        die(f"{path} 不是 {FORMAT} 的 bundle（format={b.get('format')!r}）")
    return b


def parse_path_maps(items):
    out = []
    for item in items or []:
        src, sep, dst = item.partition("=")
        src, dst = src.rstrip("/"), dst.rstrip("/")
        if not sep or not src.startswith("/") or not dst.startswith("/"):
            die(f"--path-map 要寫成 /來源/路徑=/目標/路徑：{item!r}")
        out.append((src, dst))
    return sorted(out, key=lambda m: len(m[0]), reverse=True)


def map_path(path, maps):
    """最長的先配、只換完整的路徑段；配不上原樣回傳。"""
    if not path:
        return path
    for src, dst in maps:
        if path == src or path.startswith(src + "/"):
            return dst + path[len(src):]
    return path


def rewrite(bundle, host, data_dir, now, maps=()):
    """回傳 {table: [row dict]}（已解碼、已改寫）與要寫的附件檔、改寫紀錄。"""
    t = {name: [{k: dec(v) for k, v in r.items()} for r in spec["rows"]] for name, spec in bundle["tables"].items()}
    src_host = bundle["source_host"]
    notes = {"runs_closed": [], "turns_failed": [], "autostart_off": []}
    for p in t["projects"]:
        p["host"] = host
        p["path"] = map_path(p["path"], maps)
        for k, v in PROJECT_RESET.items():
            if k in p:
                p[k] = v
        # herdr 的 workspace id 是那一台自己的短 id（`w1`、`wV`…）：專案改在目標本機跑時，帶過去的 id 在目標的 herdr 上
        # 可能剛好是別的 workspace，daemon 的 `workspace_get` 看到「存在」就把這個專案的 bot 開在不相干的地方。
        # 清掉讓目標第一次啟動時自己建；`--host <來源機器>` 的話那個 id 仍然是那台上的，原樣保留。
        if host == "local" and "workspace_id" in p:
            p["workspace_id"] = None
    for b in t["bots"]:
        b["hook_token"] = secrets.token_hex(16)
        if b.get("cwd"):
            b["cwd"] = map_path(b["cwd"], maps)
        if b.get("autostart") and b.get("managed_by") == "user" and not b.get("deleted_at"):
            notes["autostart_off"].append(b["name"])
        b["autostart"] = 0
    for r in t["runs"]:
        if r["state"] in ACTIVE_RUN:
            r["state"] = "exited"
            r["ended_at"] = r.get("ended_at") or bundle["exported_at"]
            if "exit_reason" in r:
                r["exit_reason"] = EXIT_REASON
            notes["runs_closed"].append(r["id"])
    for r in t["turns"]:
        if r["status"] in OPEN_TURN:
            r["status"] = "failed"
            r["completed_at"] = r.get("completed_at") or now
            if "awaits_start" in r:
                r["awaits_start"] = 0
            notes["turns_failed"].append(r["id"])
    files = []
    for a in t["attachments"]:
        if a["host"] == src_host:
            a["host"] = host
        a["agent_path"] = map_path(a["agent_path"], maps)
        # 遠端 bot 的附件：daemon 讀的是自己資料目錄底下的副本（attach.rs `local_copy_dir`）。
        name = os.path.basename(a["agent_path"])
        a["local_path"] = os.path.join(data_dir, "attachments", a["bot_id"], name)
        if a["id"] in bundle["files"]:
            files.append((a["local_path"], base64.b64decode(bundle["files"][a["id"]])))
    return t, files, notes


def check_config(cfg, bundle, host, project):
    hosts = {h.get("name") for h in cfg.get("hosts") or []}
    if host != "local" and host not in hosts:
        die(f"目標 config.toml 沒有 [[hosts]] name = {host!r}；先在目標加好這台主機再 import")
    existing = None
    for p in cfg.get("projects") or []:
        if p.get("id") == project["id"]:
            existing = p
        elif p.get("host", "local") == host and p.get("path") == project["path"]:
            die(f"目標 config.toml 已有另一個專案 {p.get('id')} 佔著 {host}:{project['path']}")
    if existing is not None and existing.get("host", "local") != host:
        die(f"目標 config.toml 已有專案 {project['id']} 但 host={existing.get('host', 'local')!r}，不是 {host!r}")
    return existing


def config_warnings(cfg, bots, host):
    have = {(i.get("name"), i.get("kind")) for i in cfg.get("identities") or []
            if (i.get("host") or "").strip() in ("", host)}
    out = []
    for b in bots:
        ident = b.get("identity")
        if ident and (ident, b["kind"]) not in have:
            out.append(f"bot {b['name']} 用身分 {ident}（{b['kind']}）：目標 config 沒有這個身分，"
                       f"要看 {host} 那台自己的 alias 是否認得（SPEC §16.2），否則啟動會 409")
        if b.get("herdr_session"):
            out.append(f"bot {b['name']} 釘在 herdr session {b['herdr_session']!r}（從 default session 收編的）："
                       f"目標要確認 {host} 上接得到同一個 session，`default` 的 bot 不能由 daemon 啟動（SPEC §6.5.1）")
    return out


def import_(args):
    bundle = load_bundle(args.bundle)
    config_path = os.path.expanduser(args.config)
    if not os.path.isfile(config_path):
        die(f"找不到目標 config {config_path}")
    cfg = load_toml(config_path)
    data_dir = data_dir_for(config_path, cfg)
    db_path = os.path.join(data_dir, DB_NAME)
    if not os.path.isfile(db_path):
        die(f"找不到目標 DB {db_path}：目標 daemon 要先起過一次（建好 schema）再停下來 import")

    if args.with_supervisor and "supervisor" not in bundle:
        die("--with-supervisor 但這份 bundle 沒有協調者資料：export 時也要加 --with-supervisor")
    lock = take_lock(data_dir)
    try:
        # 拿到鎖之後重讀：拿鎖前那一刻 daemon 可能剛寫過 config。
        cfg = load_toml(config_path)
        maps = parse_path_maps(args.path_map)
        project = [{k: dec(v) for k, v in r.items()} for r in bundle["tables"]["projects"]["rows"]][0]
        project["path"] = map_path(project["path"], maps)
        existing = check_config(cfg, bundle, args.host, project)
        now = now_iso()
        t, files, notes = rewrite(bundle, args.host, data_dir, now, maps)
        conn = sqlite3.connect(db_path, isolation_level=None)
        try:
            summary = write_db(conn, bundle, t, files, cfg, existing, config_path, args, notes, now)
        finally:
            conn.close()
    finally:
        os.close(lock)
    print(json.dumps(summary, ensure_ascii=False, indent=2))


def write_db(conn, bundle, t, files, cfg, existing, config_path, args, notes, now):
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA busy_timeout = 10000")
    target_cols, col_warnings = {}, []
    for name in t:
        if not has_table(conn, name):
            if t[name]:
                die(f"目標 DB 沒有 {name} 表：目標 daemon 版本太舊，先升級")
            continue
        target_cols[name] = set(columns(conn, name))
        missing = [c for c in bundle["tables"][name]["columns"] if c not in target_cols[name] and c not in PROJECT_RESET]
        # 來源有、目標沒有的欄位，整批都是 NULL 就沒有資料會丟：多半是已移除功能的舊欄（db.rs：`teams`／`team_*`
        # 還留在舊 DB 裡、沒人讀），新建的目標 DB 本來就沒有。有任何非 NULL 值才是「來源比目標新」。
        carrying = [c for c in missing if any(r.get(c) is not None for r in t[name])]
        if carrying:
            die(f"目標 DB 的 {name} 少了欄位 {carrying}（來源有非 NULL 值）：來源比目標新，先把目標 daemon 升到同版以上")
        if missing:
            col_warnings.append(f"{name} 的欄位 {missing} 目標 DB 沒有，來源這批全是 NULL，略過")
    live = conn.execute(
        "SELECT id FROM projects WHERE host = ? AND path = ? AND deleted_at IS NULL AND id <> ?",
        (args.host, t["projects"][0]["path"], t["projects"][0]["id"]),
    ).fetchone()
    if live:
        die(f"目標 DB 已有另一個活著的專案 {live[0]} 佔著 {args.host}:{t['projects'][0]['path']}")

    backups = []
    if not args.dry_run:
        b = os.path.join(os.path.dirname(conn_path(conn)), f"{DB_NAME}.pre-transfer-{stamp()}")
        dst = sqlite3.connect(b)
        conn.backup(dst)
        dst.close()
        backups.append(b)

    inserted, skipped, unique_skips, sup_report = {}, {}, [], None
    conn.execute("BEGIN IMMEDIATE")
    try:
        # bot_reads 的主鍵是 bot_id，不是 id。
        for name, rows_ in t.items():
            if name not in target_cols:
                continue
            key = "bot_id" if name == "bot_reads" else "id"
            ins = skp = 0
            for r in rows_:
                if conn.execute(f"SELECT 1 FROM {name} WHERE {key} = ?", (r[key],)).fetchone():
                    skp += 1
                    continue
                if parent_skipped(name, r, unique_skips):
                    continue
                cols = [c for c in r if c in target_cols[name]]
                try:
                    conn.execute(
                        f"INSERT INTO {name} ({', '.join(cols)}) VALUES ({', '.join('?' * len(cols))})",
                        [r[c] for c in cols],
                    )
                except sqlite3.IntegrityError as e:
                    if name in SKIP_ON_UNIQUE and "UNIQUE" in str(e):
                        unique_skips.append({"table": name, "id": r[key], "error": str(e)})
                        continue
                    raise RuntimeError(f"插入 {name} {key}={r[key]} 失敗：{e}") from e
                except sqlite3.DatabaseError as e:
                    raise RuntimeError(f"插入 {name} {key}={r[key]} 失敗：{e}") from e
                ins += 1
            inserted[name], skipped[name] = ins, skp
        if args.with_supervisor:
            sup_report = import_supervisor(conn, bundle["supervisor"], parse_path_maps(args.path_map),
                                           bundle["source_host"], now)
        bad = conn.execute("PRAGMA foreign_key_check").fetchall()
        if bad:
            raise RuntimeError(f"外鍵檢查沒過：{bad[:10]}")

        live_user_bots = sorted(
            (b for b in t["bots"] if b.get("managed_by") == "user" and not b.get("deleted_at")),
            key=lambda b: (b.get("position") or 0, b["id"]),
        )
        # 目標 config 已經有這個專案：config 不會被改，所以 bundle 裡的 user bot 必須本來就在它底下。缺的話只有 DB 有那些 bot，
        # 下次開機投影看到「bot 不在 config.toml」就把它們軟刪（而且超過一顆還會碰到批量刪除的閘門）——整批拒絕、DB 回滾。
        if existing is not None:
            have = {b.get("id") for b in existing.get("bots") or []}
            lacking = [b["name"] for b in live_user_bots if b["id"] not in have]
            if lacking:
                raise RuntimeError(f"目標 config.toml 已經有專案 {existing.get('id')}，但它底下沒有這些 bot：{', '.join(lacking)}；"
                                   f"先在 config 的那個專案底下加上它們（id 要跟 bundle 一樣），或把那個專案區塊移掉讓 import 自己寫")
        config_written = False
        if existing is None:
            with open(config_path) as f:
                text = f.read()
            # dry-run 也組一次、驗一次：寫出去會讓 daemon 起不來的 config 在 dry-run 就該看得到。
            new_text, want = compose_config(text, toml_block(t["projects"][0], live_user_bots, args.host))
        if existing is None and not args.dry_run:
            cfg_backup = f"{config_path}.pre-transfer-{stamp()}"
            shutil.copy2(os.path.realpath(config_path), cfg_backup)
            backups.append(cfg_backup)
            atomic_write(config_path, new_text)
            config_written = True
            try:
                if load_toml(config_path) != want:
                    raise RuntimeError("config.toml 寫完重讀，內容跟預期不符，已還原")
            except Exception as e:
                shutil.copy2(cfg_backup, os.path.realpath(config_path))
                raise e if isinstance(e, RuntimeError) else RuntimeError(f"config.toml 寫完重讀失敗（{e}），已還原")
        if args.dry_run:
            conn.execute("ROLLBACK")
        else:
            try:
                conn.execute("COMMIT")
            except BaseException:
                if config_written:
                    shutil.copy2(cfg_backup, os.path.realpath(config_path))
                raise
    except BaseException as e:
        if conn.in_transaction:
            conn.execute("ROLLBACK")
        if isinstance(e, RuntimeError):
            die(f"{e}（DB 已回滾，config.toml 未變更）")
        raise

    written = 0
    if not args.dry_run:
        for path, data in files:
            if os.path.exists(path):
                continue
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "wb") as f:
                f.write(data)
            written += 1

    return {
        "dry_run": args.dry_run,
        "project": t["projects"][0]["id"],
        "host": args.host,
        "inserted": inserted,
        "skipped_existing": skipped,
        "skipped_unique": unique_skips,
        "supervisor": sup_report,
        "config": "already present" if existing is not None else ("would append" if args.dry_run else "appended"),
        "config_bots": [b["name"] for b in live_user_bots],
        "attachment_files_written": written,
        "missing_attachment_files": [m["id"] for m in bundle["missing_files"]],
        "runs_closed": len(notes["runs_closed"]),
        "turns_failed": len(notes["turns_failed"]),
        "autostart_turned_off": notes["autostart_off"],
        "backups": backups,
        "warnings": bundle["warnings"] + col_warnings + config_warnings(cfg, live_user_bots, args.host)
        + transcript_warnings(t["runs"], args.host),
    }


def transcript_warnings(runs, host):
    """本機接手（`--host local`）時，對話檔要已經在這台：daemon 接回前會先看 `runs.transcript_path` 在不在，
    不在就退回開新對話。只看每段最後一個 run（接回挑的就是它），列出還沒搬過來的段數。"""
    if host != "local":
        return []
    last = {}
    for r in runs:
        if r.get("native_session_id") and r.get("transcript_path"):
            last[r["native_session_id"]] = r["transcript_path"]
    gone = sorted(sid for sid, p in last.items() if not os.path.exists(p))
    if not gone:
        return []
    return [f"{len(gone)} 段原生對話的 transcript 不在這台（例：{last[gone[0]]}）：先在來源跑 "
            f"scripts/ops/transcript-transfer 搬過來、用它輸出的 bundle 再 import，否則接回會開新對話"]


def conn_path(conn):
    return conn.execute("PRAGMA database_list").fetchone()[2]


def bundle_project_paths(path):
    return [dec(r["path"]) for r in load_bundle(path)["tables"]["projects"]["rows"]]


def main():
    ap = argparse.ArgumentParser(prog="project-transfer", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    e = sub.add_parser("export", help="從來源 DB 的快照匯出一個專案")
    e.add_argument("--db", required=True, help="來源 agents-manager.sqlite3（只讀，先做 backup 快照）")
    e.add_argument("--project", required=True, help="專案 id")
    e.add_argument("--out", required=True, help="輸出的 bundle（.json.gz，含對話內容，權限 600）")
    e.add_argument("--with-supervisor", action="store_true",
                   help="一起帶協調者（AGM）的資料：交辦、驗收、inbox（未處理＋最近 --inbox-days 天）等，SPEC §11.9b")
    e.add_argument("--inbox-days", type=int, default=7, help="supervisor_inbox 帶最近幾天（未處理的一律帶），預設 7")
    i = sub.add_parser("import", help="寫進停著的目標 daemon（config.toml＋SQLite）")
    i.add_argument("--bundle", required=True)
    i.add_argument("--host", required=True,
                   help="目標 daemon 上代表來源機器的 [[hosts]] 名（例：m4p）；專案改在目標本機跑就寫 local，並給 --path-map")
    i.add_argument("--path-map", action="append", default=[],
                   help="/來源路徑=/目標路徑（可重複）：改寫專案 path、bot cwd、附件 agent_path")
    i.add_argument("--config", default="~/.config/agents-manager/config.toml", help="目標 daemon 的 config.toml")
    i.add_argument("--dry-run", action="store_true", help="整套跑完但回滾，不寫 config／附件、不備份")
    i.add_argument("--with-supervisor", action="store_true",
                   help="合併 bundle 裡的協調者資料（export 也要加）：目標的 AGM 長期欄位換成來源的，SPEC §11.9b")
    args = ap.parse_args()
    if args.cmd == "export":
        export(args)
    else:
        if args.host == "local" and not any(
            map_path(p, parse_path_maps(args.path_map)) != p for p in bundle_project_paths(args.bundle)
        ):
            die("--host local 要搭 --path-map 把專案 path 換成這台上的路徑：不換的話 path 仍指向來源機器")
        import_(args)



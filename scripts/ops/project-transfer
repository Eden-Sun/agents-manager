                    "persona_hash", "persona_source", "persona_updated_at", "persona_seed_hash"],
        "reset": {"desired_running": 0, "status": "", "status_detail": None, "quota_reset_at": None,
                  "watchdog_attempts": 0, "watchdog_next_at": None, "watchdog_gave_up_at": None,

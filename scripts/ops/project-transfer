# 所以這是**合併**：`supervisors`／`supervisor_roles` 更新目標那一列的長期欄位（Mac 的 AGM 成為唯一的協調者），
# 其他表只插目標沒有的 id，撞唯一索引就跳過列報告；搬了哪些 id 另寫一筆 `supervisor_notes(kind='transfer')`，
# 合併後分不出來源時靠它回溯。取捨見 SPEC §11.9b。

SUP_TABLES = ["supervisor_requests", "supervisor_assignments", "supervisor_reviews", "supervisor_notes",
              "supervisor_incidents", "supervisor_approvals", "supervisor_inbox"]
# 會搬的表各挑哪些列。沒列的表（leases、bot_sleeps、intents、spawn_hints、judge_shadow、fork_ops）是這顆 daemon
# 自己的執行期狀態，不搬。
SUP_WHERE = {
    "supervisor_requests": "1",
    "supervisor_assignments": "1",  # 未結案的照原狀搬：turn 不在目標上的，reconcile 會收成 turn_missing 送驗收
    "supervisor_reviews": "1",
    "supervisor_notes": "kind NOT LIKE 'child_retirement_%'",  # 10 分鐘的退役守衛，綁來源的 bot
    "supervisor_incidents": "status = 'resolved'",  # 開著的由目標自己的探測重新判定

PARKED = "transferred (#720): not re-notified on the new host"


def collect_supervisor(conn, inbox_days, project_bots):
    if not has_table(conn, "supervisors"):
        die("來源 DB 沒有 supervisors 表：沒有協調者資料可搬")
    cutoff = (_dt.datetime.now(_dt.timezone.utc) - _dt.timedelta(days=inbox_days)).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    tables, warnings = {}, []
    for t in ["supervisors", "supervisor_roles"] + SUP_TABLES:
        if not has_table(conn, t):
            continue
        if t in SINGLETONS:
            got = rows(conn, f"SELECT * FROM {t} ORDER BY rowid")
        elif t == "supervisor_inbox":
            got = inbox_rows(conn, cutoff)
        else:
            got = rows(conn, f"SELECT * FROM {t} WHERE {SUP_WHERE[t]} ORDER BY rowid")
        tables[t] = {"columns": columns(conn, t), "rows": got}
    for t in SINGLETONS:
        for r in tables.get(t, {}).get("rows", []):
            if r.get("bot_id") and r["bot_id"] not in project_bots:
                warnings.append(f"{t} {r.get('id') or r.get('role')} 的 bot {r['bot_id']} 不在這個專案裡：先把它的專案也搬過去，"
                                f"否則目標上的協調者指到不存在的 bot")
    return {"inbox_days": inbox_days, "inbox_cutoff": cutoff, "tables": tables, "warnings": warnings}


def inbox_rows(conn, cutoff):
    """沒處理完的＋最近 N 天的，再補上它們 `merged_into` 指到的（不然合併過的事件在目標上指到不存在的列）。"""
    got = rows(conn, f"SELECT * FROM supervisor_inbox WHERE state <> 'handled' OR {TS.format(c='created_at')} >= ? ORDER BY rowid",
               (cutoff,))
    have = {r["id"] for r in got}
    todo = [r["merged_into"] for r in got if r.get("merged_into") and r["merged_into"] not in have]
    while todo:
        more = rows(conn, f"SELECT * FROM supervisor_inbox WHERE id IN ({in_list(todo)})", todo)
        todo = []
        for r in more:
            if r["id"] not in have:
                have.add(r["id"])
                got.append(r)
                if r.get("merged_into") and r["merged_into"] not in have:
                    todo.append(r["merged_into"])
    return got


ULID_ALPHABET = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"


def ulid():
    n = (int(_dt.datetime.now(_dt.timezone.utc).timestamp() * 1000) << 80) | int.from_bytes(secrets.token_bytes(10), "big")
    return "".join(ULID_ALPHABET[(n >> (5 * i)) & 31] for i in reversed(range(26)))


def import_supervisor(conn, sup, maps, source_host, now):
    """在呼叫端的交易裡合併；回傳報告。"""
    report = {"singletons": {}, "inserted": {}, "skipped_existing": {}, "skipped_unique": [], "inbox_parked": 0,
              "transfer_note": None}
    imported = {}
    for t, (key, spec) in SINGLETONS.items():
        if t not in sup["tables"] or not has_table(conn, t):
            continue
        cols = set(columns(conn, t))
        for r in [{k: dec(v) for k, v in r.items()} for r in sup["tables"][t]["rows"]]:
            if r.get("cwd"):
                r["cwd"] = map_path(r["cwd"], maps)
            vals = {c: r[c] for c in spec["durable"] if c in r and c in cols}
            vals.update({c: v for c, v in spec["reset"].items() if c in cols})
            if "updated_at" in cols:
                vals["updated_at"] = now
            before = row_dict(conn, t, key, r[key])
            if before is None:
                row = {c: v for c, v in r.items() if c in cols}
                row.update(vals)
                conn.execute(f"INSERT INTO {t} ({', '.join(row)}) VALUES ({', '.join('?' * len(row))})", list(row.values()))
                report["singletons"][f"{t}:{r[key]}"] = "inserted"
            elif any(before.get(c) != v for c, v in vals.items() if c != "updated_at"):
                conn.execute(f"UPDATE {t} SET {', '.join(f'{c} = ?' for c in vals)} WHERE {key} = ?",
                             [*vals.values(), r[key]])
                report["singletons"][f"{t}:{r[key]}"] = "updated"
            else:
                report["singletons"][f"{t}:{r[key]}"] = "unchanged"
    for t in SUP_TABLES:
        if t not in sup["tables"]:
            continue
        if not has_table(conn, t):
            if sup["tables"][t]["rows"]:
                die(f"目標 DB 沒有 {t} 表：目標 daemon 版本太舊，先升級")
            continue
        cols = set(columns(conn, t))
        ins = skp = 0
        for r in [{k: dec(v) for k, v in r.items()} for r in sup["tables"][t]["rows"]]:
            if conn.execute(f"SELECT 1 FROM {t} WHERE id = ?", (r["id"],)).fetchone():
                skp += 1
                continue
            if parent_skipped(t, r, report["skipped_unique"]):
                continue
            if t == "supervisor_inbox" and r.get("state") in ("pending", "delivered"):
                # 使用者 2026-09-28：搬過去的未處理事件不再通知一次。`gave_up`＝還沒結案、協調者看得到、daemon 不再推；
                # 直接寫成 gave_up 不會觸發「放棄補送就叫醒另一個角色」（那只在 delivered→gave_up 的當下發生）。
                r.update(state="gave_up", notify_next_at=None, notify_error=PARKED)
                report["inbox_parked"] += 1
            row = {c: v for c, v in r.items() if c in cols}
            try:
                conn.execute(f"INSERT INTO {t} ({', '.join(row)}) VALUES ({', '.join('?' * len(row))})", list(row.values()))
            except sqlite3.IntegrityError as e:
                if "UNIQUE" not in str(e):
                    raise RuntimeError(f"插入 {t} id={r['id']} 失敗：{e}") from e
                report["skipped_unique"].append({"table": t, "id": r["id"], "error": str(e)})
                if t == "supervisor_inbox" and r.get("state") == "gave_up" and r.get("notify_error") == PARKED:
                    report["inbox_parked"] -= 1
                continue
            ins += 1
            imported.setdefault(t, []).append(r["id"])
        report["inserted"][t], report["skipped_existing"][t] = ins, skp
    touched = any(imported.values()) or any(v in ("inserted", "updated") for v in report["singletons"].values())
    if touched and has_table(conn, "supervisor_notes"):
        note = {"issue": 720, "source_host": source_host, "inbox_days": sup["inbox_days"],
                "inbox_cutoff": sup["inbox_cutoff"], "singletons": report["singletons"], "imported": imported,
                "skipped_unique": report["skipped_unique"]}
        nid = ulid()
        conn.execute("INSERT INTO supervisor_notes (id, supervisor_id, kind, body, version, created_at) VALUES (?,?,?,?,?,?)",
                     (nid, "AGM", "transfer", json.dumps(note, ensure_ascii=False), 1, now))
        report["transfer_note"] = nid
    return report


def parent_skipped(table, r, skips):
    """父列這次撞唯一索引被跳過的話，這一列也跳過並記一筆（`skips` 就地加）。"""
    if table not in FOLLOWS_PARENT:
        return False
    col, parent = FOLLOWS_PARENT[table]
    if r.get(col) and any(x["table"] == parent and x["id"] == r[col] for x in skips):
        skips.append({"table": table, "id": r["id"], "error": f"{parent} {r[col]} 被跳過，跟著跳過"})
        return True
    return False


def row_dict(conn, table, key, value):
    cur = conn.execute(f"SELECT * FROM {table} WHERE {key} = ?", (value,))
    r = cur.fetchone()
    return None if r is None else dict(zip([d[0] for d in cur.description], r))



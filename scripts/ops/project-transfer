FORMAT = "agm-project-transfer/1"
DB_NAME = "agents-manager.sqlite3"
# 插入順序＝外鍵順序。`bot_reads`、`missions`／`mission_events` 是子模組的表，舊 DB 可能沒有。
TABLES = ["projects", "bots", "conversations", "runs", "turns", "messages", "attachments", "bot_reads",
          "missions", "mission_events"]
OPTIONAL_TABLES = {"bot_reads", "missions", "mission_events"}
# 撞到唯一索引就跳過並列進報告（#720，使用者 2026-09-28），不整批中止：這些表的 client_request_id／event_key
# 在兩顆 daemon 各自產生，碰巧同名不代表是同一筆。專案本體（projects／bots／對話）照舊撞了就整批回滾。
SKIP_ON_UNIQUE = {"missions", "mission_events"}
# 父列被跳過時，子列一起跳過（不留孤兒）：子表 → (指向父列的欄位, 父表)。
FOLLOWS_PARENT = {"mission_events": ("mission_id", "missions"), "supervisor_reviews": ("assignment_id", "supervisor_assignments")}
ACTIVE_RUN = ("starting", "running", "stopping")
OPEN_TURN = ("queued", "in_flight")
EXIT_REASON = "project transfer"
# 目標自己管的欄位：來源的值帶過去是錯的，目標沒有這一欄也不算缺欄。
PROJECT_RESET = {"handed_off_to": None}


def die(msg):
    print(f"project-transfer: {msg}", file=sys.stderr)
    sys.exit(1)


def now_iso():
    t = _dt.datetime.now(_dt.timezone.utc)
    return t.strftime("%Y-%m-%dT%H:%M:%S.") + f"{t.microsecond // 1000:03d}Z"


def stamp():
    return _dt.datetime.now().strftime("%Y%m%d-%H%M%S")


def enc(v):
    if isinstance(v, (bytes, bytearray)):
        return {"$b64": base64.b64encode(bytes(v)).decode()}
    return v


def dec(v):
    if isinstance(v, dict) and set(v) == {"$b64"}:
        return base64.b64decode(v["$b64"])
    return v


def has_table(conn, name):
    return conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (name,)).fetchone() is not None


def columns(conn, table):
    return [r[1] for r in conn.execute(f"PRAGMA table_info({table})")]


def rows(conn, sql, args=()):
    cur = conn.execute(sql, args)
    names = [d[0] for d in cur.description]
    return [{k: enc(v) for k, v in zip(names, r)} for r in cur.fetchall()]


def in_list(ids):
    return ",".join("?" * len(ids))


# ---------------------------------------------------------------- export


def export(args):
    if not os.path.isfile(args.db):
        die(f"找不到來源 DB {args.db}")
    tmp = tempfile.mkdtemp(prefix="agm-transfer-")
    try:
        snap_path = os.path.join(tmp, "snapshot.sqlite3")
        src = sqlite3.connect(f"file:{os.path.abspath(args.db)}?mode=ro", uri=True)
        snap = sqlite3.connect(snap_path)
        try:
            src.backup(snap)
        finally:
            src.close()
        try:
            bundle = collect(snap, args.project)
            if args.with_supervisor:
                bots = {dec(r["id"]) for r in bundle["tables"]["bots"]["rows"]}
                bundle["supervisor"] = collect_supervisor(snap, args.inbox_days, bots)
                bundle["warnings"] += bundle["supervisor"].pop("warnings")
        finally:
            snap.close()
    finally:
        # 快照是整顆 DB 的複本（含其他專案與 hook token），讀完當下刪。
        shutil.rmtree(tmp, ignore_errors=True)
    out = args.out
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as raw, gzip.GzipFile(fileobj=raw, mode="wb") as f:
        f.write(json.dumps(bundle, ensure_ascii=False).encode())
    counts = {t: len(bundle["tables"][t]["rows"]) for t in TABLES if t in bundle["tables"]}
    print(json.dumps({"out": out, "project": bundle["project_id"], "counts": counts,
                      "files": len(bundle["files"]), "missing_files": bundle["missing_files"],
                      "warnings": bundle["warnings"]}, ensure_ascii=False, indent=2))


def collect(conn, project_id):
    warnings = []
    proj = rows(conn, "SELECT * FROM projects WHERE id = ?", (project_id,))
    if not proj:
        die(f"來源 DB 沒有專案 {project_id}")
    if proj[0].get("deleted_at"):
        die(f"專案 {project_id} 已軟刪（deleted_at={proj[0]['deleted_at']}），不移交已刪的專案")
    data = {"projects": proj}
    # 已軟刪的 bot 不移交：列本身與它的對話、run、附件都留在來源（使用者 2026-09-28）。
    data["bots"] = rows(conn, "SELECT * FROM bots WHERE project_id = ? AND deleted_at IS NULL ORDER BY rowid", (project_id,))
    for b in data["bots"]:
        # 來源的 token 在 A 機上仍然有效，不帶出去；import 一律重產。
        b["hook_token"] = ""
    bot_ids = [b["id"] for b in data["bots"]]
    if bot_ids:
        stray = conn.execute(
            f"SELECT id, name, project_id FROM bots WHERE parent_bot_id IN ({in_list(bot_ids)}) AND project_id <> ?",
            (*bot_ids, project_id),
        ).fetchall()
        for bid, name, pid in stray:
            warnings.append(f"child {name}（{bid}）掛在這個專案的 bot 底下但屬於專案 {pid}，沒有搬")

    def by_bot(table):
        if not bot_ids:
            return []
        return rows(conn, f"SELECT * FROM {table} WHERE bot_id IN ({in_list(bot_ids)}) ORDER BY rowid", bot_ids)

    data["conversations"] = by_bot("conversations")
    # rowid 順序照原樣插：`last_native_session` 挑「最後一個 run」的第二鍵是 rowid（issue #461）。
    data["runs"] = by_bot("runs")
    conv_ids = [c["id"] for c in data["conversations"]]
    for table in ("turns", "messages"):
        data[table] = (
            rows(conn, f"SELECT * FROM {table} WHERE conversation_id IN ({in_list(conv_ids)}) ORDER BY rowid", conv_ids)
            if conv_ids
            else []
        )
    data["attachments"] = by_bot("attachments")
    data["bot_reads"] = by_bot("bot_reads") if has_table(conn, "bot_reads") else []
    # 群組任務跟著專案走（#720）：以前沒帶，專案搬過去群組任務的歷史就不見了。
    data["missions"] = (rows(conn, "SELECT * FROM missions WHERE project_id = ? ORDER BY rowid", (project_id,))
                        if has_table(conn, "missions") else [])
    mission_ids = [m["id"] for m in data["missions"]]
    data["mission_events"] = (
        rows(conn, f"SELECT * FROM mission_events WHERE mission_id IN ({in_list(mission_ids)}) ORDER BY rowid", mission_ids)
        if mission_ids and has_table(conn, "mission_events") else []
    )

    files, missing = {}, []
    for a in data["attachments"]:
        if a.get("state") != "ready":
            continue
        try:
            with open(a["local_path"], "rb") as f:
                files[a["id"]] = base64.b64encode(f.read()).decode()
        except OSError as e:
            missing.append({"id": a["id"], "local_path": a["local_path"], "error": str(e)})

    tables = {}
    for t in TABLES:
        if t in OPTIONAL_TABLES and not has_table(conn, t):
            continue
        tables[t] = {"columns": columns(conn, t), "rows": data[t]}
    return {
        "format": FORMAT,
        "project_id": project_id,
        "exported_at": now_iso(),
        "source_user_version": conn.execute("PRAGMA user_version").fetchone()[0],
        "source_host": proj[0]["host"],
        "tables": tables,
        "files": files,
        "missing_files": missing,
        "warnings": warnings,
    }



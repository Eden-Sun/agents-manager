# 來源檔（issue #677）：改這裡再照 scripts/ops/README.md install 到 ~/.config/systemd/user/。
# 對應 macOS 的 scripts/ops/launchd/com.agm.daemon-update.plist，排程與指令兩邊要一致（agm_test.py 釘住）。
[Unit]
Description=AGM daemon-update：正式 daemon 落後最新一顆 ubuntu-ci 綠燈的 main 時，自己建置並換版

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# 排程沒有 pane 環境：不指定的話 herdr 找的是 default session 的 socket，daemon-swap 的 `herdr pane list`
# 會回 server_not_running。指向 daemon 用的 session（`config.rs` 的 DEFAULT_HERDR_SESSION）。
Environment=HERDR_SESSION=agents-manager
ExecStart=/bin/bash %h/.config/agents-manager/supervisor/AGM/bin/daemon-update-kick.sh
StandardOutput=append:%h/.config/agents-manager/supervisor/AGM/daemon-update.systemd.log
StandardError=append:%h/.config/agents-manager/supervisor/AGM/daemon-update.systemd.log

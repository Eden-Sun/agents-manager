# 來源檔（issue #677）：改這裡再照 scripts/ops/README.md install 到 ~/.config/systemd/user/。
# 對應 macOS 的 scripts/ops/launchd/com.agm.herdr-update.plist，排程與指令兩邊要一致（agm_test.py 釘住）。
[Unit]
Description=AGM herdr-update：herdr 有新版就派人升級（唯讀）

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=/bin/bash %h/.config/agents-manager/supervisor/AGM/bin/herdr-update-kick.sh
StandardOutput=append:%h/.config/agents-manager/supervisor/AGM/herdr-update.systemd.log
StandardError=append:%h/.config/agents-manager/supervisor/AGM/herdr-update.systemd.log
